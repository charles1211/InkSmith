# ─── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project dashboard, under Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Used by the booking API to insert rows past RLS.
# Never expose this to the browser — it bypasses every row-level policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Email (transactional booking + contact mail) ────────────────────────────
# A Gmail account plus an App Password, not the account password.
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ─── reCAPTCHA v3 ────────────────────────────────────────────────────────────
# Register the site at https://www.google.com/recaptcha/admin
# Verification is skipped automatically when NODE_ENV=development.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key-here
RECAPTCHA_SECRET_KEY=your-secret-key-here

# ─── SEO ─────────────────────────────────────────────────────────────────────
# Canonical site URL, used for canonical tags, the sitemap, Open Graph and the
# links inside transactional emails. Leave blank to fall back to the Vercel
# production domain, then to the project's default URL.
NEXT_PUBLIC_SITE_URL=

# Forces robots.txt to allow (true) or block (false) indexing. Leave unset to
# derive it from VERCEL_ENV, which keeps preview deploys out of the index.
# NEXT_PUBLIC_ALLOW_INDEXING=
